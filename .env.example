# Copiar este archivo como `.env.local` y pegar los dos datos del proyecto de
# Supabase. Están en el panel: Project Settings → API.
#
#   VITE_SUPABASE_URL       → «Project URL»
#   VITE_SUPABASE_ANON_KEY  → la clave «anon public»
#
# La clave anon es pública por diseño: lo que protege los datos son las
# políticas RLS de `supabase/schema.sql`, que exigen sesión iniciada.
# La clave `service_role` no va nunca en este archivo ni en el navegador.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
